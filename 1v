<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For You</title>
    <style>
        body {
            margin: 0;
            background-color: black;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        canvas {
            display: block;
        }
    </style>
</head>
<body>
    <canvas id="heartCanvas"></canvas>
    <script>
        const canvas = document.getElementById('heartCanvas');
        const ctx = canvas.getContext('2d');

        function resize() {
            canvas.width = Math.min(window.innerWidth, 800);
            canvas.height = Math.min(window.innerHeight, 800);
        }
        resize();
        window.addEventListener('resize', resize);

        const text = "I love you";
        ctx.font = "bold 9px Arial";
        ctx.fillStyle = "#ff77a8";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        let currentScale = 11;
        let currentI = 0;
        const totalSteps = 150;

        function drawStep() {
            if (currentScale <= 17) {
                if (currentI < totalSteps) {
                    const t = (currentI / totalSteps) * Math.PI * 2;
                    const x = 16 * Math.pow(Math.sin(t), 3);
                    const y = 13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t);
                    const canvasX = canvas.width / 2 + x * currentScale;
                    const canvasY = canvas.height / 2.3 - y * currentScale;

                    ctx.fillText(text, canvasX, canvasY);
                    currentI++;
                    setTimeout(drawStep, 10); 
                } else {
                    currentScale++;
                    currentI = 0;
                    setTimeout(drawStep, 100);
                }
            }
        }
        drawStep();
    </script>
</body>
</html>
